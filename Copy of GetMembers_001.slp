        "11111111-1111-1111-1111-00000000001f": {
            "class_id": "com-snaplogic-snaps-sqlserver-execute",
            "class_version": 1,
            "instance_id": "11111111-1111-1111-1111-00000000001f",
            "property_map": {
                "account": {
                    "account_ref": {
                        "expression": true,
                        "value": "_Account"
                    }
                },
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Select Task"
                    },
                    "notes": {}
                },
                "input": {
                    "input102": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output101": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "autoCommit": {
                        "value": "Use account setting"
                    },
                    "executable_during_suggest": {
                        "value": false
                    },
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "ignoreEmptyResult": {
                        "value": true
                    },
                    "maxRetryProp": {
                        "expression": false,
                        "value": 0
                    },
                    "passThrough": {
                        "value": true
                    },
                    "queryType": {
                        "expression": false,
                        "value": "Read"
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sqlStatement": {
                        "expression": true,
                        "value": "\"\n  IF EXISTS(  SELECT NULL\n  FROM [GTC].[dbo].[Bizagi_LKP_MilestoneWorkflow] w\n  JOIN [GTC].[dbo].[Bizagi_LKP_MilestoneTask] mt ON mt.MilestoneTaskID = w.MilestoneTaskID\n  JOIN [GTC].[dbo].[Bizagi_LKP_Phase1] p1 ON p1.Phase1ID = w.Phase1ID\n  LEFT JOIN [GTC].[dbo].[Bizagi_LKP_Phase2] p2 ON p2.Phase2ID = w.Phase2ID\n  JOIN [GTC].[dbo].[Bizagi_LKP_Role] r ON r.RoleID = w.RoleID\n  WHERE w.MilestoneID = \"+$milestone+\" AND UPPER(mt.MilestoneTaskName) = UPPER('\"+$taskName+\"'))\n  BEGIN\n    SELECT w.MilestoneID,w.MilestoneTaskID,w.Phase1ID,w.Phase2ID,p1.*,p2.*,w.HRAdminActionFlag, r.RoleName\n  FROM [GTC].[dbo].[Bizagi_LKP_MilestoneWorkflow] w\n  JOIN [GTC].[dbo].[Bizagi_LKP_MilestoneTask] mt ON mt.MilestoneTaskID = w.MilestoneTaskID\n  JOIN [GTC].[dbo].[Bizagi_LKP_Phase1] p1 ON p1.Phase1ID = w.Phase1ID\n  LEFT JOIN [GTC].[dbo].[Bizagi_LKP_Phase2] p2 ON p2.Phase2ID = w.Phase2ID\n  JOIN [GTC].[dbo].[Bizagi_LKP_Role] r ON r.RoleID = w.RoleID\n  WHERE w.MilestoneID = \"+$milestone+\" AND UPPER(mt.MilestoneTaskName) = UPPER('\"+$taskName+\"')\n  END\n  ELSE\n  BEGIN\n    SELECT w.MilestoneID,w.MilestoneTaskID,w.Phase1ID,w.Phase2ID,p1.*,p2.*,w.HRAdminActionFlag, r.RoleName\n  FROM [GTC].[dbo].[Bizagi_LKP_MilestoneWorkflow] w\n  JOIN [GTC].[dbo].[Bizagi_LKP_MilestoneTask] mt ON mt.MilestoneTaskID = w.MilestoneTaskID\n  JOIN [GTC].[dbo].[Bizagi_LKP_Milestone] m ON m.MilestoneID = w.MilestoneID\n  JOIN [GTC].[dbo].[Bizagi_LKP_Phase1] p1 ON p1.Phase1ID = w.Phase1ID\n  LEFT JOIN [GTC].[dbo].[Bizagi_LKP_Phase2] p2 ON p2.Phase2ID = w.Phase2ID\n  JOIN [GTC].[dbo].[Bizagi_LKP_Role] r ON r.RoleID = w.RoleID\n  WHERE m.MilestoneName= '\"+$original.milestone+\"' AND UPPER(mt.MilestoneTaskName) = UPPER('\"+$original.taskName+\"')\n  END\n\""
                    }
                },
                "view_serial": 102
            }
        },
