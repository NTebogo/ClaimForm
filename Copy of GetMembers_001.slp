        "11111111-1111-1111-1111-000000000021": {
            "class_id": "com-snaplogic-snaps-flow-filter",
            "class_version": 2,
            "instance_id": "11111111-1111-1111-1111-000000000021",
            "property_map": {
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Filter"
                    },
                    "notes": {}
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "filterExpression": {
                        "expression": true,
                        "value": "(\n    _SearchBy == ''\n    || (($caseNumber       == null ? '' : $caseNumber.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n    || (($memberName       == null ? '' : $memberName.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n    || (($Status           == null ? '' : $Status.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n    || (($fundName         == null ? '' : $fundName.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n    || (($idNumber         == null ? '' : $idNumber.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n    || (($lastModifiedDate == null ? '' : $lastModifiedDate.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n    || (($type             == null ? '' : $type.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n    || (($milestone        == null ? '' : $milestone.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n|| (($RoleName        == null ? '' : $RoleName.toString()).toLowerCase().contains(_SearchBy.toLowerCase()))\n)\n&&\n(\n    _Filter == ''\n    ||\n    (\n        _FilterType != null\n        && _FilterType.toLowerCase() == 'phase1'\n        ? $phase1ID.toString() == _Filter.toString()\n        : $phase2ID.toString() == _Filter.toString()\n    )\n)\n&&\n(\n    _IsHrAction == ''\n    || (\n        $actionHR != null\n        && $actionHR.toString().toLowerCase() == _IsHrAction.toLowerCase()\n    )\n)"
                    },
                    "nullSafeAccess": {
                        "value": true
                    }
                },
                "view_serial": 100
            }
        },
