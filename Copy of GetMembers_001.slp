                "settings": {
                    "editable_content": {
                        "value": "try { load(\"nashorn:mozilla_compat.js\"); } catch (e) { }\r\n\r\nimportPackage(com.snaplogic.scripting.language)\r\nimportClass(java.util.ArrayList)\r\nimportClass(java.util.LinkedHashMap)\r\n\r\nvar impl = {\r\n    input: input,\r\n    output: output,\r\n    error: error,\r\n    log: log,\r\n\r\n    execute: function () {\r\n        while (this.input.hasNext()) {\r\n            var doc = this.input.next()\r\n            var membersMap = doc[\"members\"]\r\n            var arr = new ArrayList()\r\n            var keys = []\r\n\r\n            for (var k in membersMap) {\r\n                if (String(k).match(/^\\d+$/)) {\r\n                    keys.push(String(k))\r\n                }\r\n            }\r\n\r\n            keys.sort(function(a, b) {\r\n                return parseInt(a, 10) - parseInt(b, 10)\r\n            })\r\n\r\n            for (var i = 0; i < keys.length; i++) {\r\n                arr.add(membersMap[keys[i]])\r\n            }\r\n\r\n            var out = new LinkedHashMap()\r\n            out.put(\"members\", arr)\r\n            out.put(\"pagination\", doc[\"pagination\"])\r\n\r\n            this.output.write(out)\r\n        }\r\n    }\r\n}\r\n\r\nvar hook = new com.snaplogic.scripting.language.ScriptHook(impl)"
