        "11111111-1111-1111-1111-00000000001d": {
            "class_id": "com-snaplogic-snaps-transform-datatransform",
            "class_version": 4,
            "instance_id": "11111111-1111-1111-1111-00000000001d",
            "property_map": {
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Map Notes"
                    },
                    "notes": {}
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "nullSafeAccess": {
                        "value": true
                    },
                    "passThrough": {
                        "value": false
                    },
                    "transformations": {
                        "value": {
                            "mappingRoot": {
                                "value": "$"
                            },
                            "mappingTable": {
                                "value": [
                                    {
                                        "expression": {
                                            "expression": false,
                                            "value": "Has the fund benefit been utilised as security for an approved pension backed housing loan?"
                                        },
                                        "targetPath": {
                                            "value": "notes[0].question"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "jsonPath($, \"entity[*].noteCategory.name\").indexOf(\"Housing Loan\")  > -1 ? \"YES\":\"NO\""
                                        },
                                        "targetPath": {
                                            "value": "notes[0].answer"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": false,
                                            "value": "Are you indebted to the employer due to theft, dishonesty, fraud or misconduct in terms of the Pension Funds Act?"
                                        },
                                        "targetPath": {
                                            "value": "notes[1].question"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "jsonPath($, \"entity[*].noteCategory.name\").indexOf(\"Company Indebtedness\")  > -1 ? \"YES\":\"NO\""
                                        },
                                        "targetPath": {
                                            "value": "notes[1].answer"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.original.id"
                                        },
                                        "targetPath": {
                                            "value": "id"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.original.identityNumber"
                                        },
                                        "targetPath": {
                                            "value": "identityNumber"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "jsonPath($, \"entity[*]\")\n        .filter(x =>\n            x.noteCategory.name.toUpperCase() == \"Housing loan balance (monthly)\".toUpperCase()\n        )\n        .sort((a, b) =>\n            Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)\n        )[0]\n        .amount\n"
                                        },
                                        "targetPath": {
                                            "value": "HLAmount"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "Date.parse(\n    jsonPath($, \"entity[*]\")\n        .filter(x =>\n            x.noteCategory.name.toUpperCase() == \"Housing loan balance (monthly)\".toUpperCase()\n        )\n        .sort((a, b) =>\n            Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)\n        )[0]\n        .effectiveDate\n).toLocaleDateString()"
                                        },
                                        "targetPath": {
                                            "value": "HLEffectiveDate"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "jsonPath($, \"entity[*]\")\n        .filter(x =>\n            x.noteCategory.name.toUpperCase() == \"Housing loan balance (monthly)\".toUpperCase()\n        )\n        .sort((a, b) =>\n            Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)\n        )[0] != null ? jsonPath($, \"entity[*]\")\n        .filter(x =>\n            x.noteCategory.name.toUpperCase() == \"Housing loan balance (monthly)\".toUpperCase()\n        )\n        .sort((a, b) =>\n            Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)\n        )[0].description.concat(' Balance').trim():null"
                                        },
                                        "targetPath": {
                                            "value": "HLdescription"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "jsonPath($, \"entity[*]\")         .filter(x =>             x.noteCategory.name.toUpperCase() == \"Housing Loan\".toUpperCase()          )         .sort((a, b) =>             Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)         )[0]         .amount"
                                        },
                                        "targetPath": {
                                            "value": "HLInitialAmount"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "Date.parse(\n    jsonPath($, \"entity[*]\")\n        .filter(x =>\n            x.noteCategory.name.toUpperCase() == \"Housing Loan\".toUpperCase()\n        )\n        .sort((a, b) =>\n            Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)\n        )[0]\n        .effectiveDate\n).toLocaleDateString()"
                                        },
                                        "targetPath": {
                                            "value": "HLInitialEffectiveDate"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "jsonPath($, \"entity[*]\")        .filter(x =>            x.noteCategory.name.toUpperCase() == \"Housing loan\".toUpperCase()        )        .sort((a, b) =>            Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)        )[0] != null ? jsonPath($, \"entity[*]\")        .filter(x =>            x.noteCategory.name.toUpperCase() == \"Housing loan\".toUpperCase()        )        .sort((a, b) =>            Date.parse(b.effectiveDate) - Date.parse(a.effectiveDate)        )[0].description.trim():null\n"
                                        },
                                        "targetPath": {
                                            "value": "HLInitialdescription"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "view_serial": 100
            }
        },
