        "11111111-1111-1111-1111-000000000008": {
            "class_id": "com-snaplogic-snaps-script-script",
            "class_version": 2,
            "instance_id": "11111111-1111-1111-1111-000000000008",
            "property_map": {
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Script Vested"
                    },
                    "notes": {}
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "editable_content": {
                        "value": "// JavaScript for the Script Snap (requires global variable: hook)\r\n\r\nvar impl = {\r\n  input: input,\r\n  output: output,\r\n  error: error,\r\n  log: log,\r\n\r\n  execute: function () {\r\n    while (this.input.hasNext()) {\r\n      var doc = this.input.next();\r\n\r\n      try {\r\n        var bands = doc.TaxBands;\r\n        var amount = +doc.WithDrawalAmount;   // comes from the Mapper step above\r\n\r\n        var band = null;\r\n        for (var i = 0; i < bands.length; i++) {\r\n          var from = +bands[i].from;\r\n          var to = +bands[i].to;\r\n          if (amount >= from && amount <= to) {\r\n            band = bands[i];\r\n            break;\r\n          }\r\n        }\r\n\r\n        if (band) {\r\n          var tax = (+band.baseTax + (amount - (+band.from)) * (+band.rate));\r\n\r\n          tax = parseFloat(parseFloat(tax).toFixed(2));\r\n          amount = parseFloat(parseFloat(amount).toFixed(2));\r\n\r\n          doc.VestedTax = tax;\r\n          doc.VestedNet = amount - tax;\r\n          doc.AppliedTaxRate = +band.rate;\r\n        } else {\r\n          doc.VestedTax = null;\r\n          doc.VestedNet = null;\r\n        }\r\n\r\n        // keep lineage\r\n        this.output.write(doc, doc);\r\n\r\n      } catch (e) {\r\n        this.log.error(e);\r\n        this.error.write({ errorMsg: String(e) });\r\n      }\r\n    }\r\n  }\r\n};\r\n\r\n// REQUIRED by the Script Snap contract:\r\nvar hook = new com.snaplogic.scripting.language.ScriptHook(impl);\r\n"
                    },
                    "executable_during_suggest": {
                        "value": false
                    },
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "language": {
                        "value": "Javascript"
                    },
                    "script": {
                        "expression": false,
                        "value": null
                    }
                },
                "view_serial": 100
            }
        },
        "11111111-1111-1111-1111-000000000009": {
            "class_id": "com-snaplogic-snaps-script-script",
            "class_version": 2,
            "instance_id": "11111111-1111-1111-1111-000000000009",
            "property_map": {
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
