                    }
                },
                "info": {
                    "label": {
                        "value": "Script Savings"
                    },
                    "notes": {}
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "editable_content": {
                        "value": "// JavaScript for the Script Snap (requires global variable: hook)\r\n\r\nvar impl = {\r\n  input: input,\r\n  output: output,\r\n  error: error,\r\n  log: log,\r\n\r\n  execute: function () {\r\n    while (this.input.hasNext()) {\r\n      var doc = this.input.next();\r\n\r\n      try {\r\n       var bands = doc.TaxBands;\r\nvar salary = +doc.Salary;\r\nvar withdrawalAmount = +doc.WithDrawalAmount;\r\n\r\nvar band = null;\r\n\r\nfor (var i = 0; i < bands.length; i++) {\r\n    var from = +bands[i].from;\r\n    var to = +bands[i].to;\r\n\r\n    if (salary >= from && salary <= to) {\r\n        band = bands[i];\r\n        break;\r\n    }\r\n}\r\n\r\nif (band) {\r\n    var withdrawalTax = withdrawalAmount * (+band.rate);\r\n    var withdrawalNet = withdrawalAmount - withdrawalTax;\r\n\r\n    doc.SavingsTax = parseFloat(withdrawalTax.toFixed(2));\r\n    doc.SavingsNet = parseFloat(withdrawalNet.toFixed(2));\r\n    doc.AppliedTaxRate = +band.rate;\r\n} else {\r\n    doc.SavingsTax = null;\r\n    doc.SavingsNet = null;\r\n    doc.AppliedTaxRate = null;\r\n}\r\n\r\n        // keep lineage\r\n        this.output.write(doc, doc);\r\n\r\n      } catch (e) {\r\n        this.log.error(e);\r\n        this.error.write({ errorMsg: String(e) });\r\n      }\r\n    }\r\n  }\r\n};\r\n\r\n// REQUIRED by the Script Snap contract:\r\nvar hook = new com.snaplogic.scripting.language.ScriptHook(impl);\r\n"
                    },
                    "executable_during_suggest": {
                        "value": false
                    },
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "language": {
                        "value": "Javascript"
                    },
                    "script": {
                        "expression": false,
                        "value": null
                    }
                },
                "view_serial": 100
            }
        },
