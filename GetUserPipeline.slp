                    "queryType": {
                        "expression": false,
                        "value": "Auto"
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sqlStatement": {
                        "expression": true,
                        "value": "\"SELECT tp.pkiPersonID,txtUsername,intUserLevel,txtFirstname,txtSurname,txtIDNo,txtCellPhone,txtEMailAddress,c.fkiClientID\nFROM Everest.[Everest_LongTerm_QA].dbo.tblPeople tp\nLEFT JOIN Everest.[Everest_LongTerm_QA].dbo.prgUserLevels pul ON tp.intUserLevel = pul.pkiUserLevelID\nLEFT JOIN Everest.[Everest_LongTerm_QA].dbo.prgClientAccessLevels c ON c.fkipersonid = tp.pkiPersonID\nWHERE pul.pkiUserLevelID = '5'\nAND txtUsername LIKE '%AuthSig%'\nAND txtEMailAddress = '\"+_Email+\"'\nAND blnUserLocked = 0 \""
                    }
                },
                "view_serial": 103
            }
        },
