                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.caseDate)) && Date.parse($original.caseDate) != null  ? Date.parse($original.caseDate).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['Start date - Digital Claims']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.COCaseCreationDate))  && Date.parse($original.COCaseCreationDate) != null? Date.parse($original.COCaseCreationDate).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "value": "['Start date - Customer Onboarding (Counselling)']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.milestone"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['Milestone']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.statusReason"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['Status reason']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.xpiry55Date))  && Date.parse($original.xpiry55Date) != null? Date.parse($original.xpiry55Date).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['55 day expiry date']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "\nMath.floor(\n    (Date.now().getTime() - Date.parse($original.caseDate).getTime())\n    / 86400000\n)"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['Days elapsed']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.DateClaimFormSent))  && Date.parse($original.DateClaimFormSent) != null? Date.parse($original.DateClaimFormSent).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "value": "['Date Claim Form Sent to Member']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.ClaimFormSubmitted"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['Claim form received from member Y/N']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.DateClaimFormReceived))  && Date.parse($original.DateClaimFormReceived) != null? Date.parse($original.DateClaimFormReceived).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "value": "['Date Claim Form Received from Member']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.DurationForClaimSubmission"
                                        },
                                        "targetPath": {
                                            "value": "['Days From Claim Form Sent To Received from Member']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.HRReviewDate))  && Date.parse($original.HRReviewDate) != null? Date.parse($original.HRReviewDate).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "value": "['HR  Administrator Review Date']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.HRAdminReviewed"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['HR Administrator reviewed claim form Y/N']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.HRReviewerNotes"
                                        },
                                        "targetPath": {
                                            "value": "[' HR Administrator notes']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.HRSignDate))  && Date.parse($original.HRSignDate) != null? Date.parse($original.HRSignDate).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "value": "['HR Sign Date']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.HRSignerSigned"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['HR Manager signed claim form Y/N']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.HRSignerNotes"
                                        },
                                        "targetPath": {
                                            "value": "['HR Signer notes']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.CompletedPackSentDate))  && Date.parse($original.CompletedPackSentDate) != null? Date.parse($original.CompletedPackSentDate).toLocaleDateString():null"
                                        },
                                        "targetPath": {
                                            "value": "['Claim form sent to Member and GTC Date']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.status != \"In Progress\" ? \"Completed\":\"Active\" "
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['Current Status']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.CellPhone"
                                        },
                                        "targetPath": {
                                            "value": "['Cell no.']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.email"
                                        },
                                        "targetPath": {
                                            "expression": true,
                                            "value": "['Email address']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.AlternateCellPhone"
                                        },
                                        "targetPath": {
                                            "value": "['Alternate cell no.']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.AlternateEmail"
                                        },
                                        "targetPath": {
                                            "value": "['Alternate email address']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.adminComments"
                                        },
                                        "targetPath": {
                                            "value": "['GTC Administrator notes']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.ClientTier"
                                        },
                                        "targetPath": {
                                            "value": "['Client Tier']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.memberId"
                                        },
                                        "targetPath": {
                                            "value": "['Member ID']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$original.memberNumber"
                                        },
                                        "targetPath": {
                                            "value": "['Member Number']"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!isNaN(Date.parse($original.LastActionDate)) && Date.parse($original.LastActionDate) != null ? (Math.floor((Date.now() - Date.parse($original.LastActionDate))/(1000 * 60 * 60 * 24))):null"
                                        },
                                        "targetPath": {
                                            "value": "['Case History Action Date to This Date']"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "view_serial": 100
            }
