                    "sqlStatement": {
                        "expression": true,
                        "value": "\"SELECT fkiClientID\nFROM dbo.tempEverestHR\nWHERE pkiPersonID = '\" + _PersonId + \"'\nAND fkiClientID = '\" + $ClientId + \"'\nAND (\n       (intUserLevel = '5'\n        AND txtUsername LIKE '%AuthSig%')\n    OR\n       (intUserLevel = '1'\n        AND txtFirstName LIKE '%GTC Administrator%')\n)\""
                    }
                },
