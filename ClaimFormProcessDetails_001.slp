                "settings": {
                    "arrayElementsAsDocuments": {
                        "value": true
                    },
                    "editable_content": {
                        "value": "## Enter your JSON-encoded data in this space.  Note that this text is\n## treated as an Apache Velocity template, so you can substitute values\n## from input documents or the pipeline parameters.  See the following\n## URL for more information about Velocity:\n##   https://velocity.apache.org/engine/devel/user-guide.html\n\n[\n    {\n        \"BizagiCaseID\": \"1232\",\n        \"BizagiCaseUID\": \"f430a6e3-f4d5-4f6a-8405-3e34b2d22e46\",\n        \"ClientID\": 1181424,\n        \"ParentCaseID\": \"1231\",\n        \"EventName\": null,\n        \"CaseNumber\": null,\n        \"Body\": [\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.sFundName\",\n                \"value\": \"GTC Umbreall Provident Fund\"\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.dDateofLastContribution\",\n                \"value\": \"2025-01-31\"\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.sReason\",\n                \"value\": \"Withdrawal - Resignation\"\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.sEmployerName\",\n                \"value\": \"Lancet Laboratories (Pty) Ltd Provident\"\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.dDateofWithdrawal\",\n                \"value\": \"2025-01-31\"\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.Title\",\n                \"value\": 4\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.sFullName\",\n                \"value\": \"Gounden, V ()\"\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.sSurname\",\n                \"value\": \"Gounden\"\n            },\n            {\n                \"xpath\": \"M_DigitalClaims.M_SubmittedData.dDateofBirth\",\n                \"va