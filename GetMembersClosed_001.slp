                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "editable_content": {
                        "value": "try { load(\"nashorn:mozilla_compat.js\"); } catch (e) { }\r\n\r\nimportPackage(com.snaplogic.scripting.language)\r\nimportClass(java.util.LinkedHashMap)\r\nimportClass(java.util.ArrayList)\r\n\r\nvar impl = {\r\n    input: input,\r\n    output: output,\r\n    error: error,\r\n    log: log,\r\n\r\n    execute: function () {\r\n        function getValue(obj, path) {\r\n            if (obj == null || path == null || path === \"\") return null\r\n            var parts = String(path).split(\".\")\r\n            var current = obj\r\n            for (var i = 0; i < parts.length; i++) {\r\n                if (current == null) return null\r\n                current = current[parts[i]]\r\n            }\r\n            return current\r\n        }\r\n\r\n        function compareValues(a, b) {\r\n            if (a == null && b == null) return 0\r\n            if (a == null) return 1\r\n            if (b == null) return -1\r\n\r\n            if (typeof a === \"string\" && typeof b === \"string\") {\r\n                return a.localeCompare(b)\r\n            }\r\n\r\n            if (a < b) return -1\r\n            if (a > b) return 1\r\n            return 0\r\n        }\r\n\r\n        function toJsArray(listLike) {\r\n            var arr = []\r\n            if (listLike == null) {\r\n                return arr\r\n            }\r\n\r\n            if (typeof listLike.length !== \"undefined\") {\r\n                for (var i = 0; i < listLike.length; i++) {\r\n                    arr.push(listLike[i])\r\n                }\r\n                return arr\r\n            }\r\n\r\n            if (typeof listLike.size === \"function\" && typeof listLike.get === \"function\") {\r\n                for (var j = 0; j < listLike.size(); j++) {\r\n                    arr.push(listLike.get(j))\r\n                }\r\n                return arr\r\n            }\r\n\r\n            return arr\r\n        }\r\n\r\n        while (this.input.hasNext()) {\r\n            var doc = this.input.next()\r\n\r\n            var sortField = doc[\"SortColumn\"] != null ? String(doc[\"SortColumn\"]) : \"name\"\r\n            var sortOrder = doc[\"SortDirection\"] != null ? String(doc[\"SortDirection\"]).toLowerCase() : \"asc\"\r\n            var pageSize = doc[\"RowsPerPage\"] != null ? parseInt(doc[\"RowsPerPage\"], 10) : 10\r\n            var pageNumber = doc[\"PageNumber\"] != null ? parseInt(doc[\"PageNumber\"], 10) : 1\r\n\r\n            var items = []\r\n            if (doc != null && doc[\"items\"] != null) {\r\n                items = toJsArray(doc[\"items\"])\r\n            }\r\n\r\n            items.sort(function (a, b) {\r\n                var av = getValue(a, sortField)\r\n                var bv = getValue(b, sortField)\r\n                var result = compareValues(av, bv)\r\n                return sortOrder === \"desc\" ? result * -1 : result\r\n            })\r\n\r\n            var totalRecords = items.length\r\n            var totalPages = totalRecords === 0 ? 0 : Math.ceil(totalRecords / pageSize)\r\n\r\n            if (pageNumber < 1) {\r\n                pageNumber = 1\r\n            }\r\n\r\n            var startIndex = (pageNumber - 1) * pageSize\r\n            var endIndex = startIndex + pageSize\r\n            var pageItems = items.slice(startIndex, endIndex)\r\n\r\n            var out = new LinkedHashMap()\r\n            out.put(\"sort_field\", sortField)\r\n            out.put(\"sort_order\", sortOrder)\r\n            out.put(\"page_number\", pageNumber)\r\n            out.put(\"page_size\", pageSize)\r\n            out.put(\"total_records\", totalRecords)\r\n            out.put(\"total_pages\", totalPages)\r\n            out.put(\"has_previous\", pageNumber > 1)\r\n            out.put(\"has_next\", pageNumber < totalPages)\r\n            out.put(\"records\", pageItems)\r\n\r\n            this.output.write(out)\r\n        }\r\n    },\r\n\r\n    cleanup: function () {\r\n        this.log.info(\"Cleaning up\")\r\n    }\r\n}\r\n\r\nvar hook = new com.snaplogic.scripting.language.ScriptHook(impl)"
