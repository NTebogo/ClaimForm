                    "ignoreEmptyResult": {
                        "value": true
                    },
                    "maxRetryProp": {
                        "expression": false,
                        "value": 0
                    },
                    "passThrough": {
                        "value": true
                    },
                    "queryType": {
                        "expression": false,
                        "value": "Auto"
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sqlStatement": {
                        "expression": true,
                        "value": "\"SELECT DISTINCT c.fkiClientID\nFROM Everest.[Everest_LongTerm_QA].dbo.tblPeople tp\nLEFT JOIN Everest.[Everest_LongTerm_QA].dbo.prgUserLevels pul ON tp.intUserLevel = pul.pkiUserLevelID\nLEFT JOIN Everest.[Everest_LongTerm_QA].dbo.prgClientAccessLevels c ON c.fkipersonid = tp.pkiPersonID\nWHERE pul.pkiUserLevelID = '5'\nAND txtUsername LIKE '%AuthSig%'\nAND tp.pkiPersonID = '\"+_PersonId+\"'\nAND c.fkiClientID = '\"+$ClientId+\"' \nUNION\nSELECT c.fkiClientID\nFROM Everest.[Everest_LongTerm_QA].dbo.tblPeople tp\nLEFT JOIN Everest.[Everest_LongTerm_QA].dbo.prgUserLevels pul ON tp.intUserLevel = pul.pkiUserLevelID\nLEFT JOIN Everest.[Everest_LongTerm_QA].dbo.prgClientAccessLevels c ON c.fkipersonid = tp.pkiPersonID\nWHERE pul.pkiUserLevelID = '1'\nAND txtFirstName LIKE '%GTC Administrator%'\nAND tp.pkiPersonID  = '\"+_PersonId+\"'\nAND c.fkiClientID = '\"+$ClientId+\"'\""
                    }
                },
                "view_serial": 104
            }
        },
