                        }
                    }
                },
                "output": {
                    "output102": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "autoCommit": {
                        "value": "Use account setting"
                    },
                    "executable_during_suggest": {
                        "value": false
                    },
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "ignoreEmptyResult": {
                        "value": false
                    },
                    "maxRetryProp": {
                        "expression": false,
                        "value": 0
                    },
                    "passThrough": {
                        "value": true
                    },
                    "queryType": {
                        "expression": false,
                        "value": "Read"
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sqlStatement": {
                        "expression": true,
                        "value": "\"SELECT TOP (1)\n       cm.IDFromSourceSystem AS CIFNumber,\n       bp.*,\n       bct.MemberId\nFROM Bizagi_Process bp\n\nLEFT JOIN ODSEntity e\n    ON e.IDNumber = CONVERT(VARCHAR(13), bp.ClientId)\n\nLEFT JOIN CustomerMapping cm\n    ON cm.ODSEntityID = e.ID\n   AND cm.Division = 6\n\nOUTER APPLY\n(\n    SELECT TOP (1)\n           b.MemberId\n    FROM Bizagi_Claim_Tracking b\n    WHERE b.CIFNumber = cm.IDFromSourceSystem\n    ORDER BY b.TriggerDate DESC\n) bct\n\nWHERE bp.CaseUID = '\"+$CaseUID+\"'\n  AND bp.ClientID IS NOT NULL\n  AND bp.CaseUrlLink IS NOT NULL;\""
                    }
                },
                "view_serial": 102
            }
        },
