                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "editable_content": {
                        "value": "// Ensure compatibility with both JDK 7 and 8 JSR-223 Script Engines\ntry { load(\"nashorn:mozilla_compat.js\"); } catch (e) { }\ntry { load(\"https://cdnjs.cloudflare.com/ajax/libs/crypto-js/3.1.9/crypto-js.js\"); } catch (e) { }\ntry { load(\"https://cdnjs.cloudflare.com/ajax/libs/crypto-js/3.1.9/rollups/aes.js\"); } catch (e) { }\n\n// Import the interface required by the Script snap.\nimportPackage(com.snaplogic.scripting.language);\n\n// Import the serializable Java type we'll use for the output data.\nimportClass(java.util.LinkedHashMap);\n\n/**\n * Create an object that implements the methods defined by the \"ScriptHook\"\n * interface.  We'll be passing this object to the constructor for the\n * ScriptHook interface.\n */\nvar impl = {\n  /*\n   * These variables (input, output, error, log) are defined by the\n   * ExecuteScript snap when evaluating this script.\n   */\n  input: input,\n  output: output,\n  error: error,\n  log: log,\n\n  /**\n   * The \"execute()\" method is called once when the pipeline is started\n   * and allowed to process its inputs or just send data to its outputs.\n   *\n   * Exceptions are automatically caught and sent to the error view.\n   */\n  execute: function () {\n    this.log.info(\"Executing Transform Script\");\n    while (this.input.hasNext()) {\n\n      // Read the next document, wrap it in a map and write out the wrapper\n      var doc = this.input.next();\n      var secret = doc.get(\"EncryptionKey\").toString();\n      var key = CryptoJS.enc.Utf8.parse(secret);\n      //var iv = CryptoJS.lib.WordArray.create(key.words.slice(0, 4));\n      //var plainText = { \"name\": \"John\", \"age\": 30, \"city\": \"New York\" };\n      var plainText = doc.get(\"Payload\");\n      //var plainJson = JSON.parse(plainText);\n\n      // Encrypt the plaintext\n      /*var cipherText = CryptoJS.AES.encrypt(plainText.toString(), key, {\n        iv: iv,\n        mode: CryptoJS.mode.CBC\n      });*/\n\n      var cipherText = CryptoJS.AES.encrypt(plainText, secret);\n\n      var wrapper = new java.util.HashMap();\n      //var map = { \"fruits\": cipherText.toString(), \"test\": JSON.stringify(plainText) };//, \"IV\": CryptoJS.enc.Base64.stringify(iv) }\n      wrapper.put(\"original\", doc);\n      wrapper.put(\"test\", plainText);\n      wrapper.put(\"Encrypted\", cipherText.toString());\n      this.output.write(doc, wrapper);\n      //this.output.write(doc,map);\n      this.log.info(\"Script executed\");\n    }\n  },\n\n  /**\n   * The \"cleanup()\" method is called after the snap has exited the execute() method\n   */\n  cleanup: function () {\n    this.log.info(\"Cleaning up\")\n  }\n};\n\n/**\n * The Script Snap will look for a ScriptHook object in the \"hook\"\n * variable.  The snap will then call the hook's \"execute\" method.\n */\nvar hook = new com.snaplogic.scripting.language.ScriptHook(impl);\n"
                    },
                    "executable_during_suggest": {
                        "value": false
                    },
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "language": {
                        "value": "Javascript"
                    },
                    "script": {
                        "expression": false,
                        "value": null
                    }
                },
                "view_serial": 100
            }
